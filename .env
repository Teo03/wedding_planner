# Dev-only values. Safe to commit for this demo; rotate before any real deployment.
POSTGRES_DB=wedding
POSTGRES_USER=wedding
POSTGRES_PASSWORD=wedding
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://wedding:wedding@db:5432/wedding

DJANGO_SECRET_KEY=dev-insecure-change-me-please
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TIME_ZONE=Europe/Skopje

# Auto-created on first boot for /admin
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin
